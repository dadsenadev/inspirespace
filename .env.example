# Supabase Connection
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct PostgreSQL Connection (Transaction / Session Pooler for Drizzle)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"

# Indian KYB/KYC Verification Provider ("SANDBOX" | "SETU" | "CASHFREE")
KYC_PROVIDER="SANDBOX"

# Setu Verification APIs (Optional - falls back to SANDBOX if unset)
SETU_BASE_URL="https://dg-sandbox.setu.co/api/verify"
SETU_CLIENT_ID=""
SETU_CLIENT_SECRET=""
SETU_PRODUCT_INSTANCE_ID=""

# Cashfree Verification Secure ID APIs (Optional - falls back to SANDBOX if unset)
CASHFREE_VERIFICATION_BASE_URL="https://sandbox.cashfree.com/verification"
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""

# Razorpay Route & Escrow Configuration (Indian Intermediary OPC Pvt Ltd)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Platform GSTIN & Entity Metadata
PLATFORM_LEGAL_NAME="Inspirespace Launchpad (OPC) Private Limited"
PLATFORM_GSTIN="29AAAAA0000A1Z5"
